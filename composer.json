{
    "name": "emporiqa/sylius-plugin",
    "type": "sylius-plugin",
    "description": "Integrates Sylius with Emporiqa chat assistant.",
    "license": "MIT",
    "keywords": [
        "sylius",
        "sylius-plugin",
        "emporiqa",
        "ecommerce",
        "chat",
        "ai",
        "cart",
        "webhook"
    ],
    "homepage": "https://emporiqa.com",
    "support": {
        "issues": "https://gitlab.com/emporiqa/integrations/sylius/-/issues",
        "docs": "https://emporiqa.com/docs/sylius/"
    },
    "require": {
        "php": ">=8.1",
        "sylius/sylius": "^1.12 || ^2.0",
        "doctrine/doctrine-bundle": "^2.9 || ^3.0",
        "symfony/http-client": "^6.4 || ^7.0",
        "symfony/security-bundle": "^6.2 || ^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0 || ^11.0",
        "symfony/test-pack": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Emporiqa\\SyliusPlugin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Emporiqa\\SyliusPlugin\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.5-dev"
        }
    }
}
