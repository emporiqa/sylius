{
    "name": "emporiqa/sylius-plugin",
    "type": "sylius-plugin",
    "description": "Emporiqa AI Chat integration for Sylius — product sync, cart & checkout, widget embedding, order tracking, and order completion webhooks.",
    "license": "MIT",
    "keywords": [
        "sylius",
        "sylius-plugin",
        "emporiqa",
        "ecommerce",
        "chat",
        "ai",
        "cart",
        "webhook"
    ],
    "homepage": "https://emporiqa.com",
    "support": {
        "issues": "https://gitlab.com/emporiqa/integrations/sylius/-/issues",
        "docs": "https://emporiqa.com/docs/"
    },
    "require": {
        "php": ">=8.1",
        "sylius/sylius": "^1.12 || ^2.0",
        "symfony/http-client": "^6.4 || ^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0 || ^11.0",
        "symfony/test-pack": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Emporiqa\\SyliusPlugin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Emporiqa\\SyliusPlugin\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0-dev"
        }
    }
}
